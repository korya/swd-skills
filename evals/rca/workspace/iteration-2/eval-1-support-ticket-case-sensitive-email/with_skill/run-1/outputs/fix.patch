-"""In-memory user store. Case-sensitive lookups by email."""
+"""In-memory user store.
 
-from dataclasses import dataclass
-from typing import Optional
+Email identity lives here and nowhere else: two emails name the same user
+iff `email_key(a) == email_key(b)`. The store enforces that on write
+(uniqueness) and on read (lookup), so no caller needs to know the rule.
+"""
+
+from dataclasses import dataclass, field
+from typing import NewType, Optional
+
+EmailKey = NewType("EmailKey", str)
+
+
+def email_key(email: str) -> EmailKey:
+    """Canonical identity form of an email address: trimmed and case-folded."""
+    return EmailKey(email.strip().casefold())
+
+
+class DuplicateEmail(Exception):
+    pass
 
 
 @dataclass
 class User:
     id: int
-    email: str
+    email: str          # as the user typed it, for display only
     name: str
+    key: EmailKey = field(init=False, repr=False, compare=False)
+
+    def __post_init__(self) -> None:
+        self.key = email_key(self.email)
 
 
 _USERS: list[User] = []
@@ -23,6 +43,8 @@
 
 def insert(email: str, name: str) -> User:
     global _NEXT_ID
+    if find_by_email(email) is not None:
+        raise DuplicateEmail(email)
     user = User(id=_NEXT_ID, email=email, name=name)
     _NEXT_ID += 1
     _USERS.append(user)
@@ -30,8 +52,9 @@
 
 
 def find_by_email(email: str) -> Optional[User]:
+    key = email_key(email)
     for u in _USERS:
-        if u.email == email:
+        if u.key == key:
             return u
     return None
 
