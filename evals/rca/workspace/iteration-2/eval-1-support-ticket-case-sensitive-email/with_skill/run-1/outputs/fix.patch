diff -ruN a/tests/test_email_identity.py b/tests/test_email_identity.py
--- a/tests/test_email_identity.py	1969-12-31 19:00:00.000000000 -0500
+++ b/tests/test_email_identity.py	2026-10-23 14:22:58.130222655 -0400
@@ -0,0 +1,47 @@
+"""Email identity is case- and whitespace-insensitive in every flow that looks a user up."""
+
+import sys
+import unittest
+
+sys.path.insert(0, str(__import__("pathlib").Path(__file__).resolve().parents[1]))
+
+from app import db, signup, search, invite, password_reset  # noqa: E402
+
+STORED = "Bob@Example.COM"
+VARIANTS = ["bob@example.com", "BOB@EXAMPLE.COM", "Bob@example.com", " Bob@Example.COM "]
+
+
+class EmailIdentityTests(unittest.TestCase):
+    def setUp(self):
+        db.reset()
+        self.bob = signup.signup(email=STORED, name="Bob")
+
+    def test_store_lookup_ignores_case_and_whitespace(self):
+        for v in VARIANTS:
+            with self.subTest(v=v):
+                self.assertEqual(db.find_by_email(v), self.bob)
+
+    def test_signup_rejects_case_variant_duplicates(self):
+        for v in VARIANTS:
+            with self.subTest(v=v):
+                with self.assertRaises(signup.SignupError):
+                    signup.signup(email=v, name="Impostor")
+        self.assertEqual(len(db.all_users()), 1)
+
+    def test_store_enforces_uniqueness_without_signup(self):
+        with self.assertRaises(db.DuplicateEmail):
+            db.insert(email="bob@example.com", name="Bypass")
+
+    def test_search_invite_and_reset_agree_with_signup(self):
+        for v in VARIANTS:
+            with self.subTest(v=v):
+                self.assertEqual(search.search_by_email(v)["id"], self.bob.id)
+                self.assertEqual(invite.send_invite(v)["status"], "already_member")
+                self.assertEqual(password_reset.request_reset(v), f"reset-token-for-{self.bob.id}")
+
+    def test_display_email_keeps_user_casing(self):
+        self.assertEqual(search.search_by_email("bob@example.com")["email"], STORED)
+
+
+if __name__ == "__main__":
+    unittest.main()
